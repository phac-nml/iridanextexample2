{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/iridanextexample2/main/assets/schema_output.json",
    "title": "IRIDA Next Example 2 Output Schema",
    "description": "The iridanextexample2-specific schema used for validating IRIDA Next JSON output data",
    "type": "object",
    "properties": {
        "files": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "array",
                    "items": {
                        "properties": {
                            "path": {}
                        },
                        "additionalProperties": false
                    },
                    "uniqueItems": true
                },
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "properties": {
                                    "path": {
                                        "anyOf": [
                                            {
                                                "pattern": "^.*fastqc.html$",
                                                "description": "FastQC example output."
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "description": "The sample ID."
                                },
                                "single_end": {
                                    "description": "Whether or not the sample is single-end."
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            }
        }
    }
}
