nextflow_pipeline {

    name "Schema Testing"
    script "main.nf"

    test("Schema - Bad Metadata") {
        tag "schema_bad_metadata"
        config "${projectDir}/tests/configs/iridanext_bad_metadata.config"

        when {
            params {
                input = "$baseDir/assets/samplesheet.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success

            def combined_stdout = workflow.stdout.join(",")

            assert combined_stdout.contains("JSON did not match schema")
            assert combined_stdout.contains('BAD_METADATA failed')
        }
    }
}
